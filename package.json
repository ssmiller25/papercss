{
  "name": "papercss",
  "version": "2.0.0",
  "description": "The less formal CSS framework.",
  "private": true,
  "main": "dist/paper.css",
  "style": "dist/paper.css",
  "jsdelivr": "dist/paper.min.css",
  "scripts": {
    "build": "npm run css:build && npm run docs:build",
    "css:build": "node ./build/build.js",
    "docs:build": "hugo --source=docs",
    "dev": "concurrently --kill-others \"npm run dev:hot-reload\" \"npm run dev:docs\"",
    "dev:hot-reload": "node ./build/hot-reload.js",
    "dev:docs": "hugo server --source=docs --disableFastRender",
    "start": "npm run dev:docs",
    "lint": "npm run lint:src && npm run lint:dist",
    "lint:src": "stylelint \"src/**/*.scss\"",
    "lint:dist": "stylelint --config .stylelint-dist.cjs \"dist/paper.css\" \"dist/paper.min.css\"",
    "lint:docs": "node scripts/check-html.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssmiller25/papercss.git"
  },
  "author": "Rhyne Vlaservich <rhyneav@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ssmiller25/papercss/issues"
  },
  "homepage": "https://papercss.r15cookie.com",
  "dependencies": {},
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "chai": "^4.1.2",
    "chalk": "^4.1.0",
    "chokidar": "^3.4.2",
    "concurrently": "^5.3.0",
    "cssnano": "^9.4.0",
    "postcss": "^8.5.29",
    "postcss-colormin": "^9.0.7",
    "rimraf": "^3.0.2",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-scss": "^7.3.0",
    "write": "^2.0.0"
  }
}
